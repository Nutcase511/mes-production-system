# AIRIOT API 配置示例
# 复制此文件为 .env 并填写实际配置值

# AIRIOT服务器地址（必填）
VITE_AIRIOT_API_URL=https://demo.airiot.link

# 项目ID（必填）
VITE_AIRIOT_PROJECT_ID=681dade8df39cd9d08ab9ffb

# 应用ID（可选）
VITE_AIRIOT_APP_ID=

# 开发模式配置
# true: 使用Mock数据
# false: 使用真实API
VITE_DEV_MODE=true
VITE_USE_MOCK_DATA=true

# Mock模式凭据（仅开发环境使用，不要提交真实密码）
# 在 .env.local 中覆盖，.env.local 不会被 git 追踪
VITE_MOCK_USERNAME_ADMIN=admin
VITE_MOCK_PASSWORD_ADMIN=admin123
VITE_MOCK_USERNAME_OPERATOR=operator
VITE_MOCK_PASSWORD_OPERATOR=123456

# API超时配置（毫秒）
VITE_API_TIMEOUT=30000
