# AIRIOT API 配置示例
# 复制此文件为 .env 并填写实际配置值

# AIRIOT服务器地址（必填）
VITE_AIRIOT_API_URL=https://your-airiot-server.com

# 项目ID（必填，从AIRIOT平台获取）
VITE_AIRIOT_PROJECT_ID=your-project-id

# 应用ID（可选）
VITE_AIRIOT_APP_ID=

# 开发模式配置
# true: 使用Mock数据
# false: 使用真实API
VITE_DEV_MODE=true
VITE_USE_MOCK_DATA=true

# Mock模式凭据（仅开发环境使用）
# 在 .env.local 中覆盖，.env.local 不会被 git 追踪
VITE_MOCK_USERNAME_ADMIN=your-admin-username
VITE_MOCK_PASSWORD_ADMIN=your-admin-password
VITE_MOCK_USERNAME_OPERATOR=your-operator-username
VITE_MOCK_PASSWORD_OPERATOR=your-operator-password

# API超时配置（毫秒）
VITE_API_TIMEOUT=30000
